{
  "annotations": {
    "list": []
  },
  "title": "Qualification Verification System Dashboard",
  "panels": [
    {
      "title": "HTTP Requests Total",
      "type": "stat",
      "datasource": "Prometheus",
      "targets": [
        {
          "expr": "sum(rate(qvs_http_requests_total[5m]))",
          "legendFormat": "requests/sec"
        }
      ],
      "gridPos": {"h": 8, "w": 6, "x": 0, "y": 0}
    },
    {
      "title": "Request Latency (p95)",
      "type": "graph",
      "datasource": "Prometheus",
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum(rate(qvs_http_request_duration_seconds_bucket[5m])) by (le))",
          "legendFormat": "p95 latency"
        }
      ],
      "gridPos": {"h": 8, "w": 12, "x": 6, "y": 0}
    },
    {
      "title": "Total Qualifications",
      "type": "stat",
      "datasource": "Prometheus",
      "targets": [
        {
          "expr": "qvs_qualifications_total",
          "legendFormat": "total"
        }
      ],
      "gridPos": {"h": 8, "w": 6, "x": 18, "y": 0}
    },
    {
      "title": "Verifications by Result",
      "type": "graph",
      "datasource": "Prometheus",
      "targets": [
        {
          "expr": "sum(rate(qvs_verifications_total[5m])) by (result)",
          "legendFormat": "{{result}}"
        }
      ],
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 8}
    },
    {
      "title": "AI Analyses Total",
      "type": "graph",
      "datasource": "Prometheus",
      "targets": [
        {
          "expr": "sum(rate(qvs_ai_analyses_total[5m])) by (result)",
          "legendFormat": "{{result}}"
        }
      ],
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 8}
    },
    {
      "title": "Active Users",
      "type": "stat",
      "datasource": "Prometheus",
      "targets": [
        {
          "expr": "qvs_active_users_total",
          "legendFormat": "users"
        }
      ],
      "gridPos": {"h": 8, "w": 6, "x": 0, "y": 16}
    },
    {
      "title": "Audit Logs Total",
      "type": "stat",
      "datasource": "Prometheus",
      "targets": [
        {
          "expr": "qvs_audit_logs_total",
          "legendFormat": "logs"
        }
      ],
      "gridPos": {"h": 8, "w": 6, "x": 6, "y": 16}
    }
  ],
  "schemaVersion": 27,
  "version": 1,
  "refresh": "10s"
}
